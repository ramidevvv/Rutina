# Copia este archivo como .env y pon tu propia clave.
# Para generar una: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Conexión a la base de datos. En local: SQLite. En producción: la URL de Neon
DATABASE_URL=sqlite:///rutina.db

# 1 = mostrar en la terminal el SQL que se ejecuta (solo en local; en producción no se define)
SQL_ECHO=1
